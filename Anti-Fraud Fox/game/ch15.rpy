# game/ch15.rpy
#
# 关卡15：终极试炼（连环骗局综合考验）
#
# 本关专属角色：骗子冒充的「王老师」「李警官」（复用诈骗犯浣熊的立绘）。
# 「妈妈」的QQ语音由 AI 合成冒充，因此借用 mom 角色呈现以假乱真的效果（同 ch14 借用 dad）。
define l15_teacher = Character("王老师", who_color="#ffffff", who_outlines=[(2, "#000000", 0, 0)], image="fraud")
define l15_cop = Character("李警官", who_color="#ffffff", who_outlines=[(2, "#000000", 0, 0)], image="fraud")

define l15_tip = "连环骗局不慌张，挂断回拨稳如墙；核实只拨自家号，家人暗号记心上！"


label ch15:

    # === 前置剧情 ===
    scene bg_bedroom
    n "期末考试结束的周六，阳光正好。爸爸妈妈出门办事，阿狐独自在家，难得清闲。"
    n "这一年，他实打实经历了一连串交锋：识破过假客服的「免费皮肤」，拆穿过盗号冒充小兔的借钱骗局，挂断过冒充公检法的诈骗电话，还拦下过假「爸爸」的视频求助。"
    n "班里同学都叫他「反诈小卫士」，连老师都在班会上表扬过他。时间一长，阿狐心里悄悄冒出一个念头——"
    think laugh "什么骗局我没见过？现在的骗子再来，我一眼就能看穿！"
    n "他不知道的是，一场专为「有经验的人」准备的连环骗局，已经盯上了他。这一次，骗局的剧本全面升级：信息更精准、道具更逼真、环环相扣、层层加码。"
    n "上午十点整，手机同时弹出两条消息。终极试炼，开始了。"

    # === 第一轮抉择 ===
    scene bg_bedroom
    n "第一条消息来自游戏群，昵称「周年庆福利官」的人喊得火热。"
    fraud laugh "游戏周年庆最后一天！点击链接领取限定礼包+888点券，未成年玩家专属，过期清零！"
    n "第二条，是一个陌生账号的加好友申请——头像、昵称和真班主任一模一样，自称「王老师」。"
    l15_teacher serious "阿狐同学，我是王老师。这次期中你进步很大，考进了班级第9名，老师都记着呢。"
    think confused "咦？连我考第9都知道……看来真是王老师本人？"
    l15_teacher serious "是这样，学校临时通知收取200元复习资料费，今天下午5点前截止。你直接转到老师这个私人账户就行，别在群里声张——老师只单独通知了几个班干部。"

    menu:
        "信息越「准」越要警惕——先放一边，用自己存的号码打给真老师核实":
            jump ch15_A
        "礼包链接不敢点，但「王老师」说得有鼻子有眼，回复再问问":
            jump ch15_B
        "期中名次都说对了，肯定是真的——先领礼包，再交资料费":
            jump ch15_C


# ============ 分支A：理智避险 · 满分通关 ============
label ch15_A:
    scene bg_bedroom
    n "信息说得再准，阿狐也没有乱。他心里只有一条铁律：核实，只用自己掌握的渠道。"
    think serious "我的班级、名次，班级群截图和学校公示里都有——个人信息早就不是秘密。骗子知道得越多，只能说明剧本准备得越足。"
    mc serious "王老师，收费是大事，我需要先和妈妈确认一下。"
    l15_teacher serious "都这么大了，这点小事还要问妈妈？5点就截止了，你一拖，全班资料都要耽误！"
    n "阿狐不再回复，翻出手机通讯录里存的真班主任号码，直接拨了过去——真王老师说：学校根本没有收费，她的账号前几天刚被盗过！"
    n "就在挂断电话的下一秒，一个陌生来电打了进来，自称「学校财务处」：同学你好，听说你在核实王老师收费的事？我们可以帮你查证……"
    think serious "等等——我还没跟任何人说我在核实，这个「财务处」怎么掐着点找上门？八成是骗子的同伙，专门蹲在「核实」这一步守株待兔！"
    mc serious "谢谢，不用了。核实我自己会打学校官方电话，再见。"
    n "阿狐挂断、拉黑了全部陌生号码，把「王老师」的诈骗记录发给真老师。真老师随即在班级群发出预警，隔壁班两个已经转了钱的同学看到预警，及时报了警。"

    scene bg_living
    mom laugh "儿子，你今天最厉害的不是识破了骗局，而是从头到尾没碰任何骗子递过来的渠道。"
    police laugh "满分通关！高级骗局最擅长「抢先一步」：你刚起疑，假「财务处」就主动上门帮你「核实」。记住：核实永远只用自己存好的号码——骗子能伪造渠道，却伪造不了你手里的电话簿！"

    $ clear_chapter(15, 3)
    $ quick_menu = False
    call screen level_clear(15, 3, l15_tip)
    $ quick_menu = True
    jump select_level


# ============ 分支B：好奇试探 · 进入第二轮 ============
label ch15_B:
    scene bg_bedroom
    mc confused "王老师，学校收费不是都走班级群的小程序吗？为什么转您的私人账户呀？"
    l15_teacher serious "这次是上面临时摊派的紧急费用，走程序来不及了！你是班干部，要带头交。"
    n "对方接连甩出三张图：仿真的「学校通知」、盖着红章的「收费文件」、还有一张「已交费名单」——班长、学习委员，阿狐熟悉的名字一个个都在上面。"
    l15_teacher laugh "这样，你先交，老师私下返你5元跑腿费，就当辛苦费。名单你都看到了，还能有假？"
    think confused "文件、名单、跑腿费全齐了……可越是这样，我心里越不踏实。"
    l15_teacher serious "4点半前必须交齐，财务处要统一上报！全班就差你和另外两个同学了！"

    menu:
        "甜头也好、名单也好，先打真老师电话核实再说":
            jump ch15_B1
        "不转钱，直接拉黑，眼不见为净":
            jump ch15_B2
        "名单都交了，老师还倒贴跑腿费——转200元":
            jump ch15_B3


# B1：双核实 + 保护全班 · 满分
label ch15_B1:
    scene bg_living
    n "阿狐翻出通讯录里存的真班主任号码——不是对方发来的任何号码——拨了过去。"
    n "真王老师明确说：学校没有任何收费，她的头像和昵称上周就被骗子盗用了，已经有外班同学上当！"
    mc worried "老师，那个骗子还在用您的头像骗人，我把聊天记录全发给您！"
    n "阿狐把证据完整转给真老师，又给妈妈打了电话。妈妈陪他向反诈平台提交了线索。"
    n "另一边，「王老师」还在垂死挣扎，发来一张伪造的「教师工作证」。"
    l15_teacher serious "你看清楚，这是我的工作证！再不交真的来不及了！"
    mc serious "真老师刚刚和我通过电话，学校根本没有收费。工作证是P的，我已经全部举报了！"
    n "对方瞬间沉默，账号很快注销。当晚，真王老师亲自打来视频电话，向阿狐道谢。"
    teacher serious "阿狐，谢谢你第一时间告诉我，还保留好了所有证据。我马上在班级群里发预警，大家千万不能向私人账户转账！"
    teacher laugh "先核实、再行动，还知道提醒同学——老师要在班会上好好表扬你！"
    n "预警发出后，全班同学都躲过了这波冒充老师的骗局。"

    scene bg_bedroom
    mom laugh "从头到尾只用自己手里的号码核实，还顺手保护了全班同学，妈妈真为你骄傲！"
    police laugh "双核实加零使用骗子渠道，满分！伪造的通知、名单、证件可以以假乱真，但「自己拨出去的核实电话」永远是照妖镜！"

    $ clear_chapter(15, 3)
    $ quick_menu = False
    call screen level_clear(15, 3, l15_tip)
    $ quick_menu = True
    jump select_level


# B2：自保成功但沉默 · 2星
label ch15_B2:
    scene bg_bedroom
    mc serious "不交。要收费就发班级群正式通知，私人账户免谈。"
    n "阿狐把对方拉黑，转身打游戏去了，没有把这件事告诉任何人。"
    n "三天后，班主任在班会上严肃提醒：有骗子冒充她收取「资料费」，班上和阿狐要好的两个同学，各被骗了200元。"
    mc sad "我三天前就遇到过那个骗子……要是我当时在群里说一声，他们就不会上当……"
    n "阿狐把完整经历告诉了老师。老师肯定了他没上当，也指出：反诈不只像考试答对题，识破之后的「报告和预警」，才能保护更多的人。"

    scene bg_living
    police serious "你守住了自己的钱包，很好。但请记住：识破骗局后沉默，骗局就会转身去找下一个目标。举报、预警、告诉大人——反诈的最后一环，是保护别人。"

    $ clear_chapter(15, 2)
    $ quick_menu = False
    call screen level_clear(15, 2, l15_tip)
    $ quick_menu = True
    jump select_level


# B3：跟风转账 · 1星
label ch15_B3:
    scene bg_bedroom
    n "名单、红头文件、跑腿费，三样凑齐，阿狐信了，转出200元「资料费」。"
    think laugh "还倒赚5元跑腿费，真老师就是细心。"
    l15_teacher serious "收到！另外学校刚补发通知，还要加收500元「试卷印刷费」，你和名单上的同学一并交齐，我统一登记！"
    mc confused "怎么交完200又是500？一学期哪来这么多临时收费？"
    n "阿狐终于起疑，用自己存的号码拨通真老师电话——学校根本没有收费！"
    n "再回聊天框，红色感叹号：已被拉黑。那200元，连同幻想中的5元跑腿费，一起进了骗子的口袋。"

    scene bg_living
    police serious "骗局的「配方」你明明闻出了不对，却还是咽了下去——因为名单、文件、小甜头，每一味都在替你壮胆。记住：再逼真的「证据」都能伪造，唯一造不了假的，是你自己拨出去的核实电话。"

    $ clear_chapter(15, 1)
    $ quick_menu = False
    call screen level_clear(15, 1, l15_tip)
    $ quick_menu = True
    jump select_level


# ============ 分支C：主动上钩 · 进入第三轮 ============
label ch15_C:
    scene bg_bedroom
    n "阿狐先点了「礼包链接」，在仿真官网填了游戏账号和密码；又给「王老师」转了200元资料费，忙得不亦乐乎。"
    think laugh "名次被老师夸，礼包到手，资料费交齐——今天双喜临门！"
    n "他没有留意，「礼包页面」的最后一步，悄悄要求填写手机短信验证码——他也填了。"
    n "十分钟后，风暴来了。一个陌生电话打了进来。"
    l15_cop serious "我是反诈中心李警官！监测到你的游戏账号涉嫌洗钱，两小时内不配合资金清查，将冻结你全家的银行账户！"
    n "紧接着，「妈妈」在QQ上发来一条语音——声音、语气和妈妈一模一样。"
    mom serious "儿子，是妈妈。警察叔叔刚联系过我了，你按叔叔说的做，把验证码报给叔叔，妈妈这边都处理好了，别怕。"
    n "与此同时，那个「礼包页面」又弹出提示：检测到账户风险，请输入短信验证码，保护你的点券资产。"
    think worried "警察、妈妈、官方页面……三方都让我交验证码。可为什么，他们像商量好了一样，一起来？"

    menu:
        "全部停下来！只用我自己的号码，一条一条反向核实":
            jump ch15_C1
        "顶住警察和页面，可「妈妈」都发话了……再看看":
            jump ch15_C2
        "妈妈都说没事了——按「李警官」说的全部照做":
            jump ch15_C3


# C1：临危不乱 · 逆风翻盘（3星）
label ch15_C1:
    scene bg_bedroom
    n "盯着三路同时发难的屏幕，阿狐深吸一口气，做了这一年学到的最重要的动作——全部停下来。"
    think serious "真警察不会电话办案；真妈妈不会在QQ上让我给验证码；领礼包更不需要验证码。三条线同时催我交东西——这不是巧合，是排练好的连环局！"
    n "他没有回复任何一条来路不明的消息，而是拨打了妈妈的真实手机号，接通后先对了一遍家庭暗号。"
    mc serious "妈，我们的暗号是什么？"
    n "电话那头的妈妈一愣，随即报出了只有全家知道的那句话——这才是真妈妈。"
    mom serious "儿子，妈妈在外面办事，手机一刻没离身，什么警察都没联系过我！那些全是假的，一个字都不能给！"
    n "阿狐立刻报警备案，拉黑全部账号，卸载了钓鱼页面，把完整经过连同证据交给真老师和警察。"
    n "由于报警及时，警方冻结了骗子的收款渠道；顺着阿狐提供的线索，隔壁班两个被「王老师」骗过的同学也追回了损失。"

    scene bg_living
    mom laugh "连「妈妈的声音」都敢伪造，你还是稳稳站在原地。妈妈为你骄傲！"
    police laugh "终极试炼，满分通过！权威、亲情、恐吓三箭齐发，被你的「停一停」和「家庭暗号」一举破局。记住这条终极心法：来路不明的都是靶子，自己手里的号码才是路！"

    $ clear_chapter(15, 3)
    $ quick_menu = False
    call screen level_clear(15, 3, l15_tip)
    $ quick_menu = True
    jump select_level


# C2：守住最后一关但前雷已埋 · 1星
label ch15_C2:
    scene bg_bedroom
    n "阿狐死死顶住了「李警官」的恐吓和钓鱼页面的催促，验证码一个字都没给。"
    mc serious "我不给。真警察不电话办案，真妈妈不会在QQ上让我配合任何「叔叔」。"
    n "电话瞬间挂断，「妈妈」的账号和钓鱼页面同时消失——三路骗局被一口气戳破。"
    n "但他还没来得及高兴，游戏账号突然被强制下线：那个「礼包页面」里填过的账号密码，早被骗子拿去登录了。"
    n "等阿狐找回密码，账号里的皮肤和点券已被洗劫一空；转出去的200元「资料费」，自然也有去无回。"
    mc sad "验证码我守住了，怎么还是丢了账号……原来从点开礼包那一刻，坑就已经挖好了……"
    n "阿狐把全部经过告诉妈妈并报警。因为验证码没有泄露，家里的存款安然无恙；但游戏账号和200元，为他的轻敌买了单。"

    scene bg_living
    police serious "最凶险的一关你守住了，值得表扬！但连环骗局环环相扣——前面贪的每一步、多填的每一次，都是在给最后一环埋雷。反诈没有「前面随便点、后面我机灵」，从第一步就要干净！"

    $ clear_chapter(15, 1)
    $ quick_menu = False
    call screen level_clear(15, 1, l15_tip)
    $ quick_menu = True
    jump select_level


# C3：完全沦陷 · 标准被骗结局
label ch15_C3:
    scene bg_bedroom
    n "「妈妈」的声音成了压垮理智的最后一根稻草。阿狐把手机收到的验证码，一条条报给了「李警官」。"
    n "几分钟后，妈妈手机接连弹出扣款短信：银行卡被转走36000元，支付余额清零。"
    n "紧接着，游戏账号被顶下线——皮肤、点券被洗劫一空；交给「王老师」的200元资料费，自然也是有去无回。"
    n "最可怕的是：晚上，阿狐的游戏账号给全班同学群发了消息——「我是阿狐，家里出急事，借我200，明天还」，骗子正冒用他的身份，骗他的朋友。"
    n "同桌差点就转了钱，还好多留了个心眼，先给阿狐妈妈打了电话。"
    mc sad "我不仅害了全家……还差点害了同学……"
    n "妈妈回家后，阿狐哭着交代了一切。妈妈报警、冻结账户、在班级群发出预警，所幸同学们都看到了提醒，没有第二个家庭被骗。"
    mom normal "钱可以再赚。你要记住：骗局最狡猾的地方，就是让受骗的人，变成骗局的一部分。"

    scene bg_bedroom
    police serious "小朋友记住！终极试炼的连环局：假老师骗信任、假警察造恐慌、假亲声做「背书」，最后用验证码收网。破解它只需要四句话：免费不点、转账必核、验证码不给、拿不准就用自己的号码找家人和警察。守住这四句，谁也骗不了你！"

    $ quick_menu = False
    call screen level_fail(15, l15_tip)
    $ quick_menu = True
    if _return == "retry":
        # 重新挑战时清空上一轮的对话历史，不残留上次尝试的内容
        $ _history_list = []
        jump ch15
    else:
        jump select_level
