# game/ch07.rpy:164
translate english ch7_C2_52f77a3e:

    # n "100元转过去，页面又提示：解冻进度30%%，需再交400元完成全部解冻。"
    n "The 100 yuan went through, then the page showed: unfreezing progress 30%% — pay another 400 yuan to complete it."

